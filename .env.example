# --- Telegram (من @BotFather)
TELEGRAM_BOT_TOKEN=
# كلمة سر عشوائية طويلة (حروف إنجليزي وأرقام بس) — openssl rand -hex 24
WEBHOOK_SECRET=

# --- Gemini (من aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 32 بايت عشوائية base64 — openssl rand -base64 32 — ما تتغيرش بعد التشغيل
ENCRYPTION_KEY=

# --- Upstash Redis (بيتملوا لوحدهم لما تربط Upstash من Vercel Storage)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- اختياري
APP_TIMEZONE=Africa/Cairo
DEFAULT_CURRENCY=EGP
AI_DAILY_LIMIT=60
# فاضي = أي حد يقدر يستخدم البوت. أو حط أرقام تليجرام مفصولة بفاصلة
ALLOWED_USER_IDS=
