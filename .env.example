# --- Telegram (من @BotFather)
TELEGRAM_BOT_TOKEN=
# أي كلمة سر عشوائية طويلة (حروف وأرقام بس) — openssl rand -hex 24
WEBHOOK_SECRET=

# --- Gemini (من aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Google sign-in (من Google Cloud Console → Credentials → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# عنوان البوت على Vercel، من غير / في الآخر
APP_URL=https://your-app.vercel.app

# 32 بايت عشوائية base64 — openssl rand -base64 32
ENCRYPTION_KEY=

# --- Upstash Redis (بيتملوا لوحدهم لو ربطت Upstash من Vercel Marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- اختياري
APP_TIMEZONE=Africa/Cairo
DEFAULT_CURRENCY=EGP
AI_DAILY_LIMIT=60
# سيبها فاضية = أي حد يقدر يستخدم البوت. أو حط IDs مفصولة بفاصلة لمرحلة التجربة
ALLOWED_USER_IDS=
